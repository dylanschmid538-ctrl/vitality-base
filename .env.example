# Vitality Base runs with NO environment variables. Fork, deploy, done.
#
# OPTIONAL — cross-device sync + the Claude connector. Add your OWN free Supabase
# project. From Supabase → Settings → API Keys.
#   1. Create a free project at https://supabase.com
#   2. In its SQL editor run supabase/sync.sql (per-tile data), supabase/tiles.sql
#      (tiles Claude builds for you), then supabase/lockdown.sql — LAST, and only
#      once SUPABASE_SECRET_KEY below is set
#   3. Set these in Vercel → Settings → Environment Variables (and .env.local for
#      local dev), then redeploy
NEXT_PUBLIC_SUPABASE_URL=

# The SECRET key (sb_secret_… / legacy service_role). NOT public, and note the
# missing NEXT_PUBLIC_ prefix — that is what keeps it out of the browser bundle.
# The browser has NO database key at all: it calls /api/store/*, and only the
# server talks to Supabase. Earlier versions shipped the anon key to the client,
# which meant anyone who loaded the deployed page could read, rewrite and delete
# every row. supabase/lockdown.sql closes that; this key is what still gets in.
SUPABASE_SECRET_KEY=

# The password for the dashboard itself. Unset = NO GATE, which is fine on
# localhost and wrong anywhere public. A short numeric PIN is only safe because
# lib/server/loginGuard.ts locks the door after repeated failures — that lockout
# needs the auth_attempts table from supabase/lockdown.sql to actually work.
SITE_PASSWORD=

# OPTIONAL — the Claude connector password (app/api/mcp). Any long random string.
# Without it the connector is disabled (returns 503). Never commit the real value.
MCP_TOKEN=

# OPTIONAL — live-data keys. Each user adds their OWN free key — NEVER share one
# (a shared key hits its quota and gets revoked for everyone at once). TikTok
# needs NO key (keyless). Set these in .env.local for local dev and in Vercel
# → Environment Variables when live; they stay server-side and never reach the
# browser. Without them, YouTube/stock tiles just show "add a key" and manual
# entry still works.
#   YouTube subscribers → console.cloud.google.com → enable "YouTube Data API v3" → create API key
YOUTUBE_API_KEY=
#   Stock prices → https://finnhub.io → free signup → copy API key
FINNHUB_API_KEY=
